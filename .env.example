# Copy this file to .env and fill in your own values. Never commit .env.
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (local) or Supabase (use the connection details from Supabase > Project Settings > Database)
DB_NAME=skilllink
DB_USER=postgres
DB_PASSWORD=your-password
DB_HOST=localhost
DB_PORT=5432
# use "require" for Supabase, "prefer" for local
DB_SSLMODE=prefer
